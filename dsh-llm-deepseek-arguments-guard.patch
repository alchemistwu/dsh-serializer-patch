+/** Validate one tool-call block's arguments. Returns the block when its
+ * `arguments` parse as JSON; otherwise undefined. */
+function validToolCall(block: Extract<ContentBlock, { type: 'tool-call' }>): typeof block | undefined {
+  try {
+    JSON.parse(block.arguments)
+    return block
+  } catch {
+    return undefined
+  }
+}
